# ================= 应用 =================
APP_HOST=0.0.0.0
QUERY_APP_PORT=8090
IMPORT_APP_PORT=8091
# 与 MiniERP 后端一致，用于校验 MiniERP 签发的 JWT
MINIERP_JWT_SECRET=local-dev-secret-change-me-0123456789abcdef0123456789
MINIERP_API_BASE=http://localhost:8080/api
# 同步 PLM 文档时使用的 MiniERP 账号（本地演示账号）
MINIERP_SYNC_USER=eng01
MINIERP_SYNC_PASSWORD=Demo@2026

# ================= LLM（DeepSeek，OpenAI 兼容） =================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ================= 视觉模型（DashScope qwen-vl，用于 PDF 图片理解） =================
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=
VL_MODEL=qwen-vl-max

# ================= MCP 联网搜索（DashScope WebSearch，Streamable HTTP） =================
MCP_WEB_SEARCH_ENABLED=true
MCP_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_API_KEY=

# ================= MinerU（PDF 解析） =================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# ================= 本地模型 =================
BGE_M3_PATH=~/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_PATH=~/models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false

# ================= Milvus =================
MILVUS_URL=http://127.0.0.1:19531
CHUNKS_COLLECTION=minierp_kb_chunks
ITEM_NAME_COLLECTION=minierp_kb_item_names

# ================= MongoDB（会话历史） =================
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB_NAME=minierp_assistant

# ================= MinIO（原始文件与图片） =================
MINIO_ENDPOINT=127.0.0.1:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=minierp-kb
MINIO_SECURE=false
MINIO_PUBLIC_BASE=http://localhost:9010

# ================= MySQL（父文档 + ERP 只读） / Redis =================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=assistant
MYSQL_PASSWORD=assistant
MYSQL_DATABASE=assistant
ERP_DATABASE=minierp
REDIS_URL=redis://127.0.0.1:6381/0

# ================= 日志 =================
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ================= 经营与人力数据分析 Copilot =================
COPILOT_APP_PORT=8093
# 只能 SELECT 白名单视图的账号（见 mysql-init/02_copilot.sql）
COPILOT_DB_USER=copilot_ro
COPILOT_DB_PASSWORD=copilot_ro
# 评测时固定"今天"，留空则取系统日期
COPILOT_TODAY=

# ================= 企业知识库（app/kbase） =================
KBASE_APP_PORT=8094
KBASE_COLLECTION=kb_chunks_v2
KBASE_ADMIN_EMAIL=kb-admin@example.com

# 上线时改成真实地址，例如 https://erp.example.com/k3cloud ，并在金蝶"第三方系统登录授权"里申请应用 ID 和密钥
# 金蝶 EAS WebService；本地开发指向模拟网关。真实环境的密码不要提交到代码库
KINGDEE_BASE_URL=http://127.0.0.1:8096
KINGDEE_USERNAME=kb_sync
KINGDEE_PASSWORD=mock-password
KINGDEE_SLN_NAME=eas
KINGDEE_DC_NAME=mock-dc
KINGDEE_LANGUAGE=L2
KINGDEE_DB_TYPE=1
KINGDEE_FACADE=WSKbMasterDataFacade
KINGDEE_MOCK_PORT=8096

# 告警邮件；SMTP_HOST 留空时只写发件箱不发送
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kb-noreply@example.com
SMTP_TLS=false

# Neo4j 产品知识图谱（可选）
NEO4J_URL=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=minierp-kg
# ODA File Converter 路径，DWG 转 DXF 用；不配置时 DWG 文件会被拒绝并告警
ODA_CONVERTER=

# 消息队列
RABBITMQ_URL=amqp://minierp:minierp-mq@127.0.0.1:5673/%2F
KBASE_WORKERS=2
KBASE_INBOX=data/kbase_inbox
KBASE_BATCH_FAIL_RATIO=0.2
# 飞书自定义机器人告警；本地联调可以指向模拟接收端 http://127.0.0.1:8096/open-apis/bot/v2/hook/mock-token
FEISHU_WEBHOOK=
FEISHU_SECRET=
ALERT_RENOTIFY_MINUTES=60

# 大模型：默认走 OpenAI 兼容接口。换成公司自建的 vLLM + Qwen3 时只改这几项（详见 deploy/vllm/README.md）
# LLM_BASE_URL=http://gpu-server:8000/v1
# LLM_MODEL=qwen3-32b
# LLM_API_KEY=EMPTY
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=60
LLM_CONCURRENCY=16
# 限流和并发上限
COPILOT_RATE_PER_MINUTE=30
COPILOT_CONCURRENCY=16
KBASE_RATE_PER_MINUTE=30
KBASE_CONCURRENCY=8

# 链路追踪（Langfuse，可选）：docker compose --profile langfuse up -d 之后填下面几项；不填就不记录
# LANGFUSE_HOST=http://127.0.0.1:3002
# LANGFUSE_PUBLIC_KEY=pk-lf-local-minierp
# LANGFUSE_SECRET_KEY=sk-lf-local-minierp
# LANGFUSE_PROJECT_ID=minierp-ai

# 向量和重排模型的独立服务（GPU 机器上运行 python -m app.platform.model_server）；留空则在本进程里用 CPU 跑
MODEL_SERVER_URL=

# 销售与采购跟单 Workflow
WORKFLOW_APP_PORT=8095
WORKFLOW_MAIL_DIR=data/workflow_mailbox/inbox
WORKFLOW_IMAP_HOST=
WORKFLOW_IMAP_USER=
WORKFLOW_IMAP_PASSWORD=
WORKFLOW_ERP_WRITE=false
WORKFLOW_CONFIDENCE=0.75
WORKFLOW_AGENTS=true
# ---- 跟单：外部系统适配器（app/workflow/adapters）。全部 mock 时不依赖任何外部系统也能跑通 ----
# 邮箱：mock（读 WORKFLOW_MAIL_DIR 里的 eml，「发出」存到 output/workflow/sent）/ graph（Microsoft 365，推荐）/ imap
# 不填时：配了 WORKFLOW_IMAP_HOST 就是 imap，否则 mock（兼容旧配置）
WORKFLOW_EMAIL_ADAPTER=
# ERP：mock（MiniERP 自己的库当作模拟的金蝶星空；销售订单草稿存成 JSON 文件）/ kingdee（金蝶云·星空 WebAPI，只保存不审核）
WORKFLOW_ERP_ADAPTER=mock
# 派任务：mock（跟单工作台的待办中心）/ feishu（飞书任务）
WORKFLOW_TASK_ADAPTER=mock
# 知识库：mock（按产品主数据检索）/ rag（项目一的企业知识库）
WORKFLOW_KNOWLEDGE_ADAPTER=mock
# 只处理这几个订单专用邮箱（共享邮箱），不碰个人邮箱
WORKFLOW_ORDER_MAILBOXES=orders@kelang.example.com,market@kelang.example.com
# 审核 Agent 驳回后最多重写几次，超过就转人工
WORKFLOW_REVIEW_MAX_ROUNDS=2
# 模拟数据（PO、邮件、标准答案）的随机种子，固定才能复现评测
WORKFLOW_MOCK_SEED=42
# Microsoft Graph（WORKFLOW_EMAIL_ADAPTER=graph）：Entra ID 里注册的应用，证书认证；GRAPH_CLOUD=china 表示世纪互联版
GRAPH_CLOUD=global
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CERT_PATH=
# 金蝶云·星空 WebAPI（WORKFLOW_ERP_ADAPTER=kingdee）：「第三方系统登录授权」里申请，集成用户只开销售订单保存权限；LCID 2052 = 简体中文
KINGDEE_BASE_URL=
KINGDEE_ACCT_ID=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_USERNAME=
KINGDEE_LCID=2052
# 飞书自建应用（WORKFLOW_TASK_ADAPTER=feishu）：开通任务权限，任务建在这个任务清单里
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TASKLIST_GUID=
