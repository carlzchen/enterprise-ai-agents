{
 "uid": "minierp-ai",
 "title": "问数与知识库 运行监控",
 "tags": [
  "minierp"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "每分钟提问数",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ai_requests_total[5m])) * 60",
     "legendFormat": "次/分钟",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "问答 P95（秒）",
   "type": "stat",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_request_seconds_bucket[5m])))",
     "legendFormat": "P95",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 12
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
